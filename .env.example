# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Every value is optional: without Firebase the app runs fully offline,
# without RevenueCat the Pro screen explains subscriptions are unavailable.

# Firebase web app config (Firebase console → Project settings → Your apps → Web app).
# The same config is used on iOS and Android through the Firebase JS SDK.
# Get it from the CLI with: firebase apps:sdkconfig WEB <app-id>
EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=your-app-id
# 1 = talk to the local emulators (npm run emulators) instead of the real project
EXPO_PUBLIC_FIREBASE_EMULATORS=0
# Emulator host override, e.g. 127.0.0.1 for a USB phone after adb reverse (default: 10.0.2.2 on Android)
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1

# RevenueCat (Pro subscriptions on iOS/Android)
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=
# Entitlement identifier configured in RevenueCat (defaults to "pro")
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=pro

# Google Places for nearby stores (falls back to OpenStreetMap when empty)
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=

# Send a list to Instacart: off (default), mock (fake partner, for development) or live.
EXPO_PUBLIC_DELIVERY_MODE=off
