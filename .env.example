# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Every value is optional: without Supabase the app runs fully offline,
# without RevenueCat the Pro screen explains subscriptions are unavailable.

# Supabase (accounts, sync, household sharing)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# RevenueCat (Pro subscriptions on iOS/Android)
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=
# Entitlement identifier configured in RevenueCat (defaults to "pro")
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=pro

# Google Places for nearby stores (falls back to OpenStreetMap when empty)
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=
