{
  "expo": {
    "name": "GroceryCompanion",
    "slug": "GroceryCompanion",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2E7D4B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hubert24hrs.grocerycompanion",
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to scan barcodes for grocery items."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2E7D4B"
      },
      "package": "com.hubert24hrs.grocerycompanion",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow GroceryCompanion to access your camera.",
          "recordAudioAndroid": false
        }
      ],
      "expo-font",
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#2E7D4B"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ac282486-80df-482d-a161-72931cfe7c1b"
      }
    },
    "owner": "hubert24hrs"
  }
}
